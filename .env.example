# --- Supabase (browser: publishable/anon key only, never service role) ---
#
# Local dev (Vite): use VITE_*
VITE_SUPABASE_URL=https://wqkiwoossgowbrfodoiv.supabase.co
VITE_SUPABASE_ANON_KEY=
#
# Vercel + Supabase Git integration often sets these instead (no code change needed):
#   NEXT_PUBLIC_SUPABASE_URL  or  SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  or  SUPABASE_PUBLISHABLE_KEY
# Legacy names still work: VITE_SUPABASE_ANON_KEY / NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# Production requires sign-in; sign-up from the app is on unless VITE_ALLOW_SIGNUP=false.
# Your household plan stays private per login (Supabase RLS on public.plans).

# --- SimpleFIN (server only — never exposed to the browser) ---
#
# 1. Claim your setup token once:
#      curl -X POST "$(printf '%s' 'PASTE_SETUP_TOKEN' | base64 -d)"
# 2. Copy the printed URL (https://user:pass@bridge.simplefin.org/simplefin)
SIMPLEFIN_ACCESS_URL=

# Any long random string (e.g. openssl rand -base64 32).
# Set the same value in Vercel AND paste it in the app: Months → Update balances.
SYNC_SECRET=